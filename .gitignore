# =============================================
#              PYTHON
# =============================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
env/
venv/
.venv/
ENV/

# =============================================
#              DATA & MODELS
# =============================================
# Large raw datasets -- too big for git; document source instead
data/raw/*.csv
data/raw/*.h5

# Trained model artifacts -- regenerated via src/training/train_all.py
models/*.pkl
models/*.pt
models/scalers/*.pkl

# Generated outputs -- regenerated via evaluation.py
outputs/

# SQLite event log -- runtime artifact, not source
data/event_log.db
data/*.db

# =============================================
#              SYNTHETIC / GENERATED DATA
# =============================================
# Generated by relay_h5_processor.py -- not raw source data
data/raw/relay_h5_processed.csv

# Generated by data_generation/ scripts
data_generation/synthetic_transformer_dga.csv

# =============================================
#              ENVIRONMENT & CONFIG
# =============================================
.env
.env.*
*.env
config.local.py

# =============================================
